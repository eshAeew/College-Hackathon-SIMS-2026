# ==============================================================================
# API Sentinel — Environment Configuration Template
# Copy this file to .env and configure values according to your environment.
# ==============================================================================

# Application Metadata
PROJECT_NAME="API Sentinel"
ENVIRONMENT="development"      # Options: development | testing | staging | production
HOST="0.0.0.0"
PORT=8000
DEBUG=True
LOG_LEVEL="INFO"               # Options: DEBUG | INFO | WARNING | ERROR | CRITICAL

# CORS Configuration (comma-separated origins or JSON array)
CORS_ORIGINS=["*"]

# Persistence (SQLite by default, zero setup required)
DATABASE_URL="sqlite:///./api_sentinel.db"

# HTTP Testing Engine Defaults
DEFAULT_TIMEOUT_SECONDS=10.0
MAX_CONCURRENCY=10
MAX_REDIRECTS=5

# Safety & Execution Controls
ALLOW_DESTRUCTIVE_OPERATIONS=False
ALLOWED_TARGET_HOSTS=["localhost", "127.0.0.1", "0.0.0.0", "testserver"]

# AI Diagnostic Engine (Optional - leave empty for offline deterministic heuristic mode)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
